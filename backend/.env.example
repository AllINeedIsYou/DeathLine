DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/deathline
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-project@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=DeathLine
FRONTEND_URL=http://127.0.0.1:5173
MAIL_PROVIDER=smtp
# For Render, use MAIL_PROVIDER=brevo and a verified Brevo sender:
# MAIL_FROM_EMAIL=your-project@gmail.com
# BREVO_API_KEY=your-brevo-api-key
# DATABASE_URL_UNPOOLED=your-direct-neon-connection-string
# COOKIE_SECURE=true
# SERVE_FRONTEND=true
# FRONTEND_URL defaults to RENDER_EXTERNAL_URL on Render.
